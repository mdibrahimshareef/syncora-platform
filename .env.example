# ==============================================================================
# SYNCORA PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Release 18: Operational Readiness & Production Deployment Baseline
#
# INSTRUCTIONS:
# 1. Copy this template to .env.local for local development.
# 2. In production (e.g., Vercel / Cloud Run), configure these via your deployment platform.
# 3. NEVER commit real secrets or production keys to version control.
# ==============================================================================

# ==============================================================================
# 1. CLIENT-ACCESSIBLE ENVIRONMENT VARIABLES (NEXT_PUBLIC_*)
# WARNING: Variables prefixed with NEXT_PUBLIC_ are bundled into client JavaScript.
# NEVER put service-role keys, private API keys, or database credentials here.
# ==============================================================================

# Supabase Project URL
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Client Key (Public JWT with RLS enforcement)
# Required for browser authentication and public client queries
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Public Canonical Application URL
# Used for OAuth redirects, email links, and webhook callbacks
NEXT_PUBLIC_APP_URL=https://app.syncora.com

# ==============================================================================
# 2. SERVER-ONLY SECRETS & CREDENTIALS
# STRICT SECURITY REQUIREMENT: Never expose to browser or client components.
# ==============================================================================

# Node Environment ('development', 'test', 'production')
NODE_ENV=development

# Supabase Service Role Key (Bypasses RLS)
# STRICT ACCESS: Only used by server-side workers, cron, and privileged webhooks.
# Required in production.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# SYNCORA Primary Integration & Credential Encryption Key
# STRICT SECURITY REQUIREMENT: Must be exactly 32 bytes (256-bit AES-256-GCM).
# Format: 64 hexadecimal characters (recommended) or 32 UTF-8 characters.
# Generate via: openssl rand -hex 32
SYNCORA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Previous Encryption Keys for Zero-Downtime Key Rotation (Optional)
# Format: comma-separated list of previous 32-byte keys or versioned identifiers.
SYNCORA_PREVIOUS_ENCRYPTION_KEYS=

# Internal Cron & Maintenance Secret
# Protects scheduled endpoints (e.g., /api/ai/cron) against unauthorized triggers.
# Must be at least 16 characters (recommended 32+ random characters).
CRON_SECRET=your_cron_job_authentication_secret_token

# ==============================================================================
# 3. THIRD-PARTY INTEGRATIONS & WEBHOOK SECRETS (SERVER-ONLY)
# ==============================================================================

# GitHub OAuth & Inbound Webhooks
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret

# Slack App Integration & Webhooks
SLACK_CLIENT_ID=your_slack_app_client_id
SLACK_CLIENT_SECRET=your_slack_app_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Google OAuth Integration
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ==============================================================================
# 4. ARTIFICIAL INTELLIGENCE & LLM CONFIGURATION (SERVER-ONLY)
# ==============================================================================

# Primary LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# AI Provider Routing ('google' | 'openai')
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=text-embedding-3-small

# AI Guardrails & Execution Limits
AI_TIMEOUT_MS=15000
AI_MAX_STEPS=5
AI_MAX_TOOL_CALLS=10
AI_MAX_OUTPUT_TOKENS=2048

# Emergency AI Autonomy Kill-Switch ('true' | 'false')
AI_AUTONOMY_KILL_SWITCH=false
